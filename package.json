{
  "name": "railguard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": "20.x"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "bun run lint && bun run test && bun run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "typecheck": "encore check && bun run --filter @railguard/web typecheck",
    "build:web": "bun run --filter @railguard/web build",
    "dev:web": "bun run --filter @railguard/web dev",
    "dev:api": "encore run"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.48.2",
    "@workos-inc/node": "^9.1.0",
    "bs58": "^6.0.0",
    "encore.dev": "^1.56.7",
    "jose": "^6.2.2",
    "pdf-lib": "^1.17.1",
    "viem": "^2.48.4"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
