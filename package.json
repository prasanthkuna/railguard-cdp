{
  "name": "railguard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "check": "bun run lint && bun run test && bun run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "typecheck": "encore check",
    "dev:web": "bun --cwd apps/web run dev",
    "dev:api": "encore run"
  },
  "dependencies": {
    "encore.dev": "^1.56.6"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4"
  }
}
