{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@railguard/policy": ["packages/policy/src"],
      "@railguard/audit": ["packages/audit/src"],
      "@railguard/cdp": ["packages/cdp/src"],
      "@railguard/settlement": ["packages/settlement/src"],
      "@railguard/auth": ["packages/auth/src"],
      "@railguard/db": ["packages/db/src"],
      "@x402-guard/core": ["../x402-guard/packages/core/src"],
      "@x402-guard/policy": ["../x402-guard/packages/policy/src"],
      "@x402-guard/middleware": ["../x402-guard/packages/middleware/src"],
      "~encore/*": ["encore.gen/*"]
    }
  }
}
