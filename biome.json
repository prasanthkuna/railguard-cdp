{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": [
      ".encore/**",
      "encore.gen/**",
      "apps/web/.next/**",
      "apps/web/next-env.d.ts",
      "apps/video/**",
      "x402-guard/**",
      "scripts/**",
      "coinbase.code-workspace",
      "docs/**",
      ".vercel/**"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  }
}
